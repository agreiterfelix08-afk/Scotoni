# Copy this file to a new file called ".env" (with the dot, no ".example")
# and fill in the values after the "=" sign. Never share the .env file.
# (The setup script ./setup_mac.sh does this for you.)

# Your Claude API key
ANTHROPIC_API_KEY=sk-ant-put-your-key-here

# The Gmail address the bot logs in to.
# Test version: your personal Gmail address. Later: info@scotoni.it
BOT_EMAIL=your.name@gmail.com
